# ===== App =====
PORT=5005
CLIENT_URL=http://localhost:5005
BACKEND_URL=http://localhost:5005

# ===== Database (MongoDB Atlas) =====
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ChatApp
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ChatApp

# ===== Auth (use `openssl rand -base64 48`) =====
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Redis (Upstash / Redis Cloud / local) =====
# REDIS_URL=rediss://:<password>@<host>:<port>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== SMTP (Gmail app password) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ===== AWS S3 (optional - uploads fall back to local disk if empty) =====
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
